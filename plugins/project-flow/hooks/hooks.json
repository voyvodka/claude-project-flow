{
  "description": "Defect reports: records that the user replied right after a message showing the whole report preview, which report.sh send requires",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/report-guard.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/report-guard.sh\"" }
        ]
      }
    ]
  }
}
